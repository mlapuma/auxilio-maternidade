# Copie para .env.production, configure valores fortes e NUNCA envie ao Git.
DB_PASSWORD=SUBSTITUA_POR_SENHA_LONGA_ALEATORIA
ADMIN_USER=SUBSTITUA_POR_USUARIO_ADMIN
# Hash BCrypt completo, gerado com ferramenta confiavel.
# Ao usar Compose, escape cada $ do hash como $$ para evitar interpolacao.
ADMIN_PASSWORD_HASH=SUBSTITUA_POR_HASH_BCRYPT
